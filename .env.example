# ProGuidance Portal — environment contract
# Copy to .env.local for development. Never commit real values.

# ---------------------------------------------------------------------------
# Public (embedded in the browser bundle at build time — must be safe to expose)
# ---------------------------------------------------------------------------
# Local development: values printed by `supabase start`.
# Hosted: Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# Canonical site origin used for auth email redirects (falls back to request origin).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Server-only secrets (NEVER prefixed NEXT_PUBLIC_, never sent to the browser)
# ---------------------------------------------------------------------------
# Service-role key: reserved for server-side administrative operations
# (not required by any Phase 1 runtime path; the registration-approval flow
# runs under the caller's own RLS-checked session).
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection (tooling / migration checks). Local stack default:
SUPABASE_DB_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# ---------------------------------------------------------------------------
# Test infrastructure
# ---------------------------------------------------------------------------
# Superuser connection used by integration tests to create the throwaway
# proguidance_test database. Plain PostgreSQL 16+ works; Supabase not required.
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
