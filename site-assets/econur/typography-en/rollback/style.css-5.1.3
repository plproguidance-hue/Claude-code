/* ---- v3.4: hero slider, complete banner + control bar ---- */
.ecn-visually-hidden{ position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; }
.ecn-hsl{ position:relative; background:#fff; }
.ecn-hsl-track{ display:flex; overflow-x:auto; scroll-snap-type:x mandatory; scrollbar-width:none; -webkit-overflow-scrolling:touch; overscroll-behavior-x:contain; }
.ecn-hsl-track::-webkit-scrollbar{ display:none; }
.ecn-hsl-slide{ flex:0 0 100%; width:100%; scroll-snap-align:start; display:block; text-decoration:none !important; }
.ecn-hsl-slide img{ display:block; width:100%; height:auto; aspect-ratio:1920/823; object-fit:contain; background:#fff; }
.ecn-hsl-ctl{ position:relative; display:flex; align-items:center; justify-content:center; gap:2px; padding:8px 12px; background:#fff; }
.ecn-hsl-nav{ display:grid; place-items:center; width:40px; height:40px; padding:0; border:0; background:none; color:var(--ecn-ink); cursor:pointer; border-radius:50%; transition:background .2s ease; }
.ecn-hsl-nav:hover{ background:var(--ecn-olive-soft); }
.ecn-hsl-nav svg{ width:20px; height:20px; }
.ecn-hsl-dots{ display:flex; align-items:center; gap:0; position:static; padding:0; background:none; }
.ecn-hsl-dots button{ width:26px; height:34px; border:0; background:none; padding:0; position:relative; cursor:pointer; }
.ecn-hsl-dots button::before{ content:""; position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); width:9px; height:9px; border-radius:999px; border:1.5px solid var(--ecn-ink); background:transparent; transition:background .2s ease; }
.ecn-hsl-dots button.is-on::before{ background:var(--ecn-ink); }
@media (min-width:768px){
  .ecn-hsl-ctl{ padding:12px; }
  .ecn-hsl-nav{ width:44px; height:44px; }
  .ecn-hsl-nav svg{ width:22px; height:22px; }
}
/* ---- v3.3: white background everywhere (client request) ---- */
:root{ --ecn-white:#FFFFFF; --ecn-sand:#FFFFFF; --ecn-beige:#F4F4F2; --ecn-line:#E8E5DF; }
body, .site, .site-content, .ast-container, .elementor-page .e-con{ background-color:#FFFFFF; }
.ecn-hsl, .ecn-hsl-dots{ background:#FFFFFF; }
.ecn-rev3 .ecn-review:first-child{ background:#FFFFFF; border-color:var(--ecn-line); }
.ecn-trust div, .ecn-pillar{ background:#FFFFFF; border:1px solid var(--ecn-line); }
/* packaging story on white */
.ecn-story3 .ecn-steps3{ border-top-color:var(--ecn-line); }
.ecn-story3 .ecn-steps3 li{ color:var(--ecn-ink); border-bottom-color:var(--ecn-line); }
.ecn-story3 .ecn-steps3 .ecn-num{ color:var(--ecn-olive); }
.ecn-story3 .ecn-steps3 span{ color:var(--ecn-muted); }
.ecn-story3 .ecn-steps3 b{ color:var(--ecn-ink); }
/* light footer */
.site-footer{ background:#FFFFFF; color:var(--ecn-muted); border-top:1px solid var(--ecn-line); }
.site-footer a{ color:var(--ecn-ink); }
.site-footer a:hover{ color:var(--ecn-olive-dark); }
.site-below-footer-wrap{ border-top:1px solid var(--ecn-line); }
.site-below-footer-wrap .ast-footer-copyright{ color:var(--ecn-muted); }
.ecn-foot-brand img{ filter:none; opacity:1; }
.ecn-foot-social a{ border-color:var(--ecn-line); color:var(--ecn-ink); }
.ecn-foot-social a:hover{ background:var(--ecn-olive-soft); color:var(--ecn-olive-deep); }
.ecn-foot-links h4{ color:var(--ecn-ink); }
.ecn-foot-note{ color:var(--ecn-muted); }
/* PDP panels on white */
.ecn-pdp-trust div, .ecn-pdp-coming, .ecn-pdp-how p{ background:#FFFFFF !important; border:1px solid var(--ecn-line); }

/* ---- v3.5: softened green family (smooth, low contrast shift) ---- */
:root{
  --ecn-olive:#3E7A7F;
  --ecn-olive-dark:#0D585F;
  --ecn-olive-deep:#0D585F;
  --ecn-olive-soft:#E7F1F1;
  --ecn-shadow:0 10px 30px rgba(16,42,45,.10);
}
/* announcement bar: soft sage with dark text instead of a heavy dark band */
.ecn-announce{ background:var(--ecn-olive-soft) !important; color:var(--ecn-ink) !important; }
.ecn-announce strong{ color:var(--ecn-ink) !important; }
/* store notice keeps white text, so it stays on the mid green */
.woocommerce-store-notice, p.demo_store{ background:var(--ecn-olive-dark) !important; }
/* soften the green cast in button shadows */
.elementor-widget-button.ecn-btn-primary .elementor-button,
.ecn-btn-primary, .ecn-card-order{ box-shadow:0 6px 16px rgba(16,42,45,.16) !important; }

/* ---- v3.6: teal buttons (#0D585F), labels set in v5.0 ---- */
:root{
  --ecn-btn:#0D585F;
  --ecn-btn-hover:#0A474D;
  --ecn-btn-line:#0D585F;
