/*
Theme Name: Econur
Template: astra
Description: Econur child theme for Astra. Holds the Econur Earth design system CSS.
Version: 5.1.3
Text Domain: econur
*/

/* ============================================================
   ECONUR — global design system (mobile-first)
   Palette: olive / beige / warm brown / off-white
   ============================================================ */
@import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&display=swap');

:root{
  --ecn-olive:#3E7A7F;
  --ecn-olive-dark:#0D585F;
  --ecn-olive-deep:#0D585F;
  --ecn-olive-soft:#E7F1F1;
  --ecn-sand:#F7F2EA;
  --ecn-beige:#EFE6D6;
  --ecn-brown:#6B4E35;
  --ecn-clay:#B8744B;
  --ecn-ink:#2A2823;
  --ecn-muted:#6E6A60;
  --ecn-line:rgba(42,40,35,.10);
  --ecn-white:#FFFDF9;
  --ecn-radius:20px;
  --ecn-radius-sm:14px;
  --ecn-shadow:0 10px 30px rgba(16,42,45,.10);
  --ecn-font-head:'Fraunces',Georgia,serif;
  --ecn-font-body:'DM Sans',system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
}

html{ -webkit-text-size-adjust:100%; }
body, body p, body li, body input, body button, body select, body textarea{
  font-family:var(--ecn-font-body);
}
body{ background:var(--ecn-white); color:var(--ecn-ink); }
h1,h2,h3,h4,h5,h6,
.ecn h1,.ecn h2,.ecn h3,.ecn h4{
  font-family:var(--ecn-font-head); font-weight:500; letter-spacing:-.01em; color:var(--ecn-ink);
}
a{ color:var(--ecn-olive-dark); }
a:hover{ color:var(--ecn-olive); }
::selection{ background:var(--ecn-olive-soft); }

/* ---------- utility ---------- */
.ecn{ font-family:var(--ecn-font-body); color:var(--ecn-ink); }
.ecn *{ box-sizing:border-box; }
.ecn-eyebrow{
  display:inline-block; font-size:12px; font-weight:600; letter-spacing:.16em; text-transform:uppercase;
  color:var(--ecn-olive); margin:0 0 12px;
}
.ecn-h2{ font-family:var(--ecn-font-head); font-weight:500; font-size:30px; line-height:1.12; margin:0 0 10px; letter-spacing:-.01em; color:var(--ecn-ink); }
.ecn-sub{ font-size:16px; line-height:1.6; color:var(--ecn-muted); margin:0; max-width:56ch; }
.ecn-center{ text-align:center; }
.ecn-center .ecn-sub{ margin-left:auto; margin-right:auto; }
.ecn-head{ margin-bottom:28px; }

/* buttons */
.ecn-btn{
  display:inline-flex; align-items:center; justify-content:center; gap:10px;
  min-height:52px; padding:14px 26px; border-radius:999px;
  font-family:var(--ecn-font-body); font-weight:600; font-size:16px; line-height:1;
  text-decoration:none !important; transition:transform .15s ease, background .2s ease, box-shadow .2s ease;
  -webkit-tap-highlight-color:transparent; border:1.5px solid transparent;
}
.ecn-btn:active{ transform:scale(.98); }
.ecn-btn-primary{ background:var(--ecn-olive-dark); color:#fff !important; box-shadow:0 8px 20px rgba(16,42,45,.22); }
.ecn-btn-primary:hover{ background:var(--ecn-olive-deep); color:#fff !important; }
.ecn-btn-ghost{ background:transparent; color:var(--ecn-olive-dark) !important; border-color:rgba(16,42,45,.35); }
.ecn-btn-ghost:hover{ background:rgba(16,42,45,.06); }
.ecn-btn-light{ background:#fff; color:var(--ecn-olive-dark) !important; }
.ecn-btn-light:hover{ background:var(--ecn-sand); }
.ecn-btn-full{ width:100%; }
.ecn-btn svg{ width:18px; height:18px; flex:none; }

/* ---------- announcement bar ---------- */
.ecn-announce{
  background:var(--ecn-olive-deep); color:#FFFFFF; font-size:13px; letter-spacing:.02em;
  text-align:center; padding:10px 16px; line-height:1.4;
}
.ecn-announce strong{ color:#fff; font-weight:600; }

/* ---------- hero ---------- */
.ecn-hero{ display:grid; gap:26px; align-items:center; }
.ecn-hero-copy h1{ font-family:var(--ecn-font-head); font-size:38px; line-height:1.05; font-weight:500; margin:0 0 16px; letter-spacing:-.015em; }
.ecn-hero-copy h1 em{ font-style:italic; color:var(--ecn-olive); }
.ecn-hero-copy p{ font-size:17px; line-height:1.6; color:var(--ecn-muted); margin:0 0 22px; max-width:48ch; }
.ecn-hero-cta{ display:flex; flex-direction:column; gap:12px; }
.ecn-hero-proof{ display:flex; align-items:center; gap:10px; margin-top:18px; font-size:13px; color:var(--ecn-muted); }
.ecn-hero-proof .ecn-stars{ color:#C99A3B; letter-spacing:1px; font-size:14px; }
.ecn-hero-media{ position:relative; }
.ecn-hero-media img{ width:100%; height:auto; aspect-ratio:4/5; object-fit:cover; border-radius:var(--ecn-radius); display:block; box-shadow:var(--ecn-shadow); }
.ecn-hero-chip{
  position:absolute; left:14px; bottom:14px; background:rgba(255,253,249,.94); backdrop-filter:blur(6px);
  border-radius:14px; padding:10px 14px; display:flex; align-items:center; gap:10px; box-shadow:0 6px 18px rgba(0,0,0,.12);
  font-size:13px; line-height:1.25;
}
.ecn-hero-chip b{ display:block; font-weight:600; }
.ecn-hero-chip span{ color:var(--ecn-muted); }
.ecn-hero-chip .ecn-leaf{ width:34px; height:34px; border-radius:10px; background:var(--ecn-olive-soft); display:grid; place-items:center; color:var(--ecn-olive-dark); flex:none; }

/* ---------- trust badges ---------- */
.ecn-badges{ display:grid; grid-template-columns:1fr 1fr; gap:12px; }
.ecn-badge{
  display:flex; align-items:center; gap:12px; padding:14px 16px; background:#fff;
  border:1px solid var(--ecn-line); border-radius:var(--ecn-radius-sm);
}
.ecn-badge .ecn-ico{ width:40px; height:40px; border-radius:12px; background:var(--ecn-olive-soft); color:var(--ecn-olive-dark); display:grid; place-items:center; flex:none; }
.ecn-badge .ecn-ico svg{ width:20px; height:20px; }
.ecn-badge b{ display:block; font-size:14px; font-weight:600; line-height:1.2; }
.ecn-badge span{ font-size:12px; color:var(--ecn-muted); line-height:1.3; }

/* ---------- product grid (WooCommerce shortcode) ---------- */
.ecn-products .woocommerce ul.products,
.ecn-products ul.products{
  display:grid !important; grid-template-columns:repeat(2,1fr); gap:14px; margin:0; padding:0; list-style:none;
}
.ecn-products ul.products li.product{
  width:auto !important; margin:0 !important; padding:0 !important; float:none !important; clear:none !important;
  background:#fff; border:1px solid var(--ecn-line); border-radius:var(--ecn-radius-sm); overflow:hidden;
  display:flex; flex-direction:column; text-align:left; transition:transform .2s ease, box-shadow .2s ease;
}
.ecn-products ul.products li.product:hover{ transform:translateY(-3px); box-shadow:var(--ecn-shadow); }
.ecn-products ul.products li.product a img{
  width:100%; height:auto; aspect-ratio:4/5; object-fit:cover; margin:0 !important; display:block; border-radius:0;
}
.ecn-products ul.products li.product .woocommerce-loop-product__title,
.ecn-products ul.products li.product h2{
  font-family:var(--ecn-font-head); font-size:16px; line-height:1.25; font-weight:500; padding:12px 12px 4px !important; margin:0 !important; color:var(--ecn-ink);
}
.ecn-products ul.products li.product .price{
  font-family:var(--ecn-font-body); font-weight:600; font-size:15px; color:var(--ecn-olive-dark) !important; padding:0 12px; margin:0 0 10px !important; display:block;
}
.ecn-products ul.products li.product .price del{ color:var(--ecn-muted); opacity:.7; font-weight:400; }
.ecn-products ul.products li.product .star-rating{ margin:0 12px 6px !important; }
.ecn-products ul.products li.product .button,
.ecn-products ul.products li.product a.button{
  margin:auto 12px 12px !important; display:block; text-align:center; background:var(--ecn-olive-dark) !important; color:#fff !important;
  border-radius:999px !important; font-weight:600 !important; font-size:14px !important; padding:12px 14px !important; line-height:1 !important; border:0 !important;
}
.ecn-products ul.products li.product a.button:hover{ background:var(--ecn-olive-deep) !important; }
.ecn-products ul.products li.product .onsale{
  position:absolute; top:10px; left:10px; background:var(--ecn-clay); color:#fff; border-radius:999px; padding:4px 10px; font-size:11px; font-weight:600; min-height:0; line-height:1.4; margin:0;
}
.ecn-products ul.products li.product .ast-shop-product-out-of-stock,
.ecn-products ul.products li.product .ast-woo-product-category{ padding:0 12px; font-size:12px; color:var(--ecn-muted); margin:0; }
.ecn-products ul.products li.product .astra-shop-summary-wrap{ padding:0 !important; display:flex; flex-direction:column; flex:1; }
.ecn-products ul.products li.product .astra-shop-thumbnail-wrap{ position:relative; }
.ecn-products .ecn-grid-cta{ text-align:center; margin-top:22px; }

/* ---------- collections ---------- */
.ecn-collections{ display:grid; grid-template-columns:1fr 1fr; gap:12px; }
.ecn-collection{
  position:relative; display:block; border-radius:var(--ecn-radius-sm); overflow:hidden; aspect-ratio:1/1.05; text-decoration:none !important; background:var(--ecn-beige);
}
.ecn-collection img{ width:100%; height:100%; object-fit:cover; display:block; transition:transform .5s ease; }
.ecn-collection:hover img{ transform:scale(1.04); }
.ecn-collection::after{ content:""; position:absolute; inset:0; background:linear-gradient(180deg,rgba(0,0,0,0) 45%,rgba(8,26,28,.72) 100%); }
.ecn-collection .ecn-col-label{
  position:absolute; left:14px; right:14px; bottom:14px; z-index:1; color:#fff; font-family:var(--ecn-font-head); font-size:18px; font-weight:500; line-height:1.15;
  display:flex; align-items:flex-end; justify-content:space-between; gap:8px;
}
.ecn-collection .ecn-col-label small{ display:block; font-family:var(--ecn-font-body); font-size:12px; opacity:.85; margin-top:3px; font-weight:400; }
.ecn-collection .ecn-col-arrow{ width:32px; height:32px; border-radius:50%; background:rgba(255,255,255,.18); backdrop-filter:blur(4px); display:grid; place-items:center; flex:none; }
.ecn-collection .ecn-col-arrow svg{ width:16px; height:16px; }

/* ---------- packaging story ---------- */
.ecn-story{ color:#FFFFFF; }
.ecn-story .ecn-eyebrow{ color:#0D585F; }
.ecn-story .ecn-h2{ color:#fff; }
.ecn-story .ecn-sub{ color:rgba(255,255,255,.78); }
.ecn-steps{ display:grid; gap:12px; margin-top:26px; }
.ecn-step{ background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.12); border-radius:var(--ecn-radius-sm); padding:18px 18px 18px 18px; display:flex; gap:14px; align-items:flex-start; }
.ecn-step .ecn-num{ font-family:var(--ecn-font-head); font-size:26px; line-height:1; color:#0D585F; flex:none; width:36px; }
.ecn-step b{ display:block; font-size:16px; font-weight:600; margin-bottom:4px; color:#fff; }
.ecn-step span{ font-size:14px; line-height:1.55; color:rgba(255,255,255,.78); }
.ecn-story-pills{ display:flex; flex-wrap:wrap; gap:8px; margin-top:22px; }
.ecn-story-pills span{ font-size:12px; font-weight:600; letter-spacing:.04em; padding:8px 12px; border-radius:999px; border:1px solid rgba(255,255,255,.25); color:#fff; }
.ecn-story-cta{ margin-top:26px; }

/* ---------- ingredients ---------- */
.ecn-ingredients{ display:grid; grid-template-columns:1fr 1fr; gap:12px; }
.ecn-ing{ background:#fff; border:1px solid var(--ecn-line); border-radius:var(--ecn-radius-sm); padding:16px; }
.ecn-ing .ecn-ico{ width:38px; height:38px; border-radius:50%; background:var(--ecn-olive-soft); color:var(--ecn-olive-dark); display:grid; place-items:center; margin-bottom:12px; }
.ecn-ing .ecn-ico svg{ width:18px; height:18px; }
.ecn-ing b{ display:block; font-family:var(--ecn-font-head); font-weight:500; font-size:17px; margin-bottom:4px; }
.ecn-ing span{ font-size:13px; line-height:1.5; color:var(--ecn-muted); }

/* ---------- pillars (how it's made) ---------- */
.ecn-pillars{ display:grid; gap:12px; }
.ecn-pillar{ display:flex; gap:14px; align-items:flex-start; padding:18px; background:var(--ecn-sand); border-radius:var(--ecn-radius-sm); }
.ecn-pillar .ecn-ico{ width:42px; height:42px; border-radius:12px; background:#fff; color:var(--ecn-olive-dark); display:grid; place-items:center; flex:none; }
.ecn-pillar .ecn-ico svg{ width:20px; height:20px; }
.ecn-pillar b{ display:block; font-family:var(--ecn-font-head); font-weight:500; font-size:18px; margin-bottom:4px; }
.ecn-pillar span{ font-size:14px; line-height:1.55; color:var(--ecn-muted); }

/* ---------- reviews ---------- */
.ecn-reviews{ display:grid; gap:12px; }
.ecn-review{ background:#fff; border:1px solid var(--ecn-line); border-radius:var(--ecn-radius-sm); padding:20px; }
.ecn-review .ecn-stars{ color:#C99A3B; font-size:15px; letter-spacing:2px; margin-bottom:10px; }
.ecn-review p{ font-size:15px; line-height:1.6; margin:0 0 14px; color:var(--ecn-ink); }
.ecn-review b{ display:block; font-size:14px; font-weight:600; }
.ecn-review small{ font-size:12px; color:var(--ecn-muted); }
.ecn-review .ecn-verified{ display:inline-flex; align-items:center; gap:5px; font-size:11px; font-weight:600; color:var(--ecn-olive); margin-top:6px; }
.ecn-review .ecn-verified svg{ width:13px; height:13px; }

/* ---------- FAQ ---------- */
.ecn-faq{ max-width:760px; margin:0 auto; }
.ecn-faq details{ border-bottom:1px solid var(--ecn-line); }
.ecn-faq details:first-child{ border-top:1px solid var(--ecn-line); }
.ecn-faq summary{
  list-style:none; cursor:pointer; padding:18px 40px 18px 0; font-weight:600; font-size:16px; position:relative; -webkit-tap-highlight-color:transparent;
}
.ecn-faq summary::-webkit-details-marker{ display:none; }
.ecn-faq summary::after{
  content:"+"; position:absolute; right:4px; top:50%; transform:translateY(-50%); width:28px; height:28px; border-radius:50%;
  background:var(--ecn-olive-soft); color:var(--ecn-olive-dark); display:grid; place-items:center; font-weight:500; font-size:18px; line-height:1;
}
.ecn-faq details[open] summary::after{ content:"–"; }
.ecn-faq .ecn-faq-a{ padding:0 0 18px; font-size:15px; line-height:1.6; color:var(--ecn-muted); }

/* ---------- final CTA ---------- */
.ecn-final{ text-align:center; color:#fff; }
.ecn-final .ecn-h2{ color:#fff; font-size:32px; }
.ecn-final .ecn-sub{ color:rgba(255,255,255,.8); margin:0 auto; }
.ecn-final-cta{ display:flex; flex-direction:column; gap:12px; margin-top:24px; align-items:stretch; }

/* ---------- Astra / WooCommerce global polish ---------- */
.ast-container{ max-width:1180px; }
.woocommerce a.button, .woocommerce button.button, .woocommerce input.button,
.woocommerce #respond input#submit, .woocommerce a.button.alt, .woocommerce button.button.alt,
.wp-block-button__link, .ast-button, body .wc-block-components-button{
  border-radius:999px !important; font-weight:600 !important; background:var(--ecn-olive-dark); color:#fff;
}
.woocommerce a.button:hover, .woocommerce button.button:hover, .woocommerce button.button.alt:hover{ background:var(--ecn-olive-deep); color:#fff; }
.woocommerce .price, .woocommerce div.product p.price, .woocommerce ul.products li.product .price{ color:var(--ecn-olive-dark); }
.woocommerce-store-notice, p.demo_store{ background:var(--ecn-olive-deep); }
.woocommerce-message, .woocommerce-info{ border-top-color:var(--ecn-olive); }
.woocommerce-message::before, .woocommerce-info::before{ color:var(--ecn-olive); }

/* shop archive cards reuse the same look */
.woocommerce.archive ul.products, .post-type-archive-product ul.products, .tax-product_cat ul.products{
  display:grid !important; grid-template-columns:repeat(2,1fr); gap:14px;
}
.woocommerce.archive ul.products li.product, .post-type-archive-product ul.products li.product, .tax-product_cat ul.products li.product{
  width:auto !important; margin:0 !important; background:#fff; border:1px solid var(--ecn-line); border-radius:var(--ecn-radius-sm); overflow:hidden; display:flex; flex-direction:column;
}
.woocommerce.archive ul.products li.product a img{ aspect-ratio:4/5; object-fit:cover; width:100%; }
.woocommerce.archive ul.products li.product .astra-shop-summary-wrap{ padding:12px !important; }
.woocommerce.archive ul.products li.product .woocommerce-loop-product__title{ font-family:var(--ecn-font-head); font-size:16px; font-weight:500; }
.woocommerce.archive ul.products li.product a.button{ border-radius:999px !important; text-align:center; }

/* ============================================================
   Tablet & desktop
   ============================================================ */
@media (min-width:600px){
  .ecn-badges{ grid-template-columns:repeat(4,1fr); }
  .ecn-hero-cta{ flex-direction:row; }
  .ecn-hero-cta .ecn-btn{ width:auto; }
  .ecn-final-cta{ flex-direction:row; justify-content:center; }
  .ecn-final-cta .ecn-btn{ width:auto; min-width:200px; }
  .ecn-reviews{ grid-template-columns:repeat(3,1fr); }
  .ecn-steps{ grid-template-columns:repeat(3,1fr); }
  .ecn-pillars{ grid-template-columns:repeat(3,1fr); }
  .ecn-ingredients{ grid-template-columns:repeat(3,1fr); }
}
@media (min-width:900px){
  .ecn-h2{ font-size:40px; }
  .ecn-sub{ font-size:17px; }
  .ecn-head{ margin-bottom:36px; }
  .ecn-hero{ grid-template-columns:1.05fr .95fr; gap:56px; }
  .ecn-hero-copy h1{ font-size:58px; }
  .ecn-hero-copy p{ font-size:18px; }
  .ecn-hero-chip{ left:22px; bottom:22px; padding:12px 16px; font-size:14px; }
  .ecn-products ul.products{ grid-template-columns:repeat(4,1fr); gap:20px; }
  .ecn-products ul.products li.product .woocommerce-loop-product__title{ font-size:18px; padding:14px 16px 6px !important; }
  .ecn-products ul.products li.product .price{ padding:0 16px; }
  .ecn-products ul.products li.product a.button{ margin:auto 16px 16px !important; }
  .ecn-collections{ grid-template-columns:repeat(4,1fr); gap:18px; }
  .ecn-collection .ecn-col-label{ font-size:20px; }
  .ecn-ingredients{ gap:18px; }
  .ecn-ing{ padding:22px; }
  .ecn-steps{ gap:18px; margin-top:34px; }
  .ecn-step{ padding:24px; display:block; }
  .ecn-step .ecn-num{ margin-bottom:12px; }
  .ecn-reviews{ gap:18px; }
  .ecn-review{ padding:26px; }
  .ecn-final .ecn-h2{ font-size:44px; }
  .woocommerce.archive ul.products, .post-type-archive-product ul.products, .tax-product_cat ul.products{ grid-template-columns:repeat(4,1fr); gap:20px; }
}

/* ---- patch 1: full-bleed elementor pages + grid specificity ---- */
.elementor-page .site-content > .ast-container,
.elementor-page .site-content .ast-container{ max-width:100% !important; padding-left:0 !important; padding-right:0 !important; }
.elementor-page #primary, .elementor-page #primary > .ast-row, .elementor-page .ast-article-single{ margin:0 !important; padding:0 !important; }
.elementor-page .site-content{ padding:0; }
.elementor-page .entry-content{ margin:0; }
.elementor-page .elementor-widget-html, .elementor-page .elementor-widget-shortcode{ width:100%; }
.elementor-page .elementor-widget:not(:last-child){ margin-bottom:0; }
.ecn-products ul.products, .ecn-products ul.products[class*="columns-"]{ display:grid !important; grid-template-columns:repeat(2,minmax(0,1fr)) !important; gap:14px !important; margin:0 !important; padding:0 !important; }
.woocommerce.archive ul.products, .post-type-archive-product ul.products, .tax-product_cat ul.products{ grid-template-columns:repeat(2,minmax(0,1fr)) !important; gap:14px !important; }
@media (min-width:900px){
  .ecn-products ul.products, .ecn-products ul.products[class*="columns-"]{ grid-template-columns:repeat(4,minmax(0,1fr)) !important; gap:20px !important; }
  .woocommerce.archive ul.products, .post-type-archive-product ul.products, .tax-product_cat ul.products{ grid-template-columns:repeat(4,minmax(0,1fr)) !important; gap:20px !important; }
}

/* ---- patch 2: mobile badges, product card label, header & footer ---- */
@media (max-width:599px){ .ecn-badge span{ display:none; } .ecn-badge{ padding:12px 14px; } .ecn-badge b{ font-size:13px; } }
.ecn-products ul.products li.product .astra-shop-summary-wrap{ padding-top:10px !important; }
.ecn-products ul.products li.product .ast-woo-product-category, .woocommerce ul.products li.product .ast-woo-product-category{ font-size:11px; letter-spacing:.08em; text-transform:uppercase; color:var(--ecn-olive); padding:0 12px; }
@media (min-width:1000px){ .ecn-products ul.products, .ecn-products ul.products[class*="columns-"]{ grid-template-columns:repeat(5,minmax(0,1fr)) !important; gap:16px !important; } .ecn-products ul.products li.product .woocommerce-loop-product__title{ font-size:16px; padding:12px 12px 4px !important; } .ecn-products ul.products li.product .price{ padding:0 12px; } .ecn-products ul.products li.product a.button{ margin:auto 12px 12px !important; } }
/* header */
.site-header{ border-bottom:1px solid var(--ecn-line); }
.ast-primary-header-bar, .ast-mobile-header-wrap .ast-primary-header-bar{ background:var(--ecn-white) !important; }
.main-header-menu > .menu-item > .menu-link{ font-family:var(--ecn-font-body); font-weight:500; font-size:15px; color:var(--ecn-ink); }
.main-header-menu > .menu-item:hover > .menu-link, .main-header-menu > .current-menu-item > .menu-link{ color:var(--ecn-olive-dark); }
.ast-site-identity .site-logo-img img{ max-height:36px; width:auto; }
.ast-header-woo-cart .ast-cart-menu-wrap, .ast-site-header-cart .ast-woo-header-cart-info-wrap{ color:var(--ecn-ink); }
.ast-site-header-cart .ast-site-header-cart-data .ast-cart-menu-wrap .count, .ast-site-header-cart .ast-icon-shopping-cart{ color:var(--ecn-ink); }
.ast-cart-menu-wrap .count:after{ border-color:var(--ecn-ink); }
.ast-site-header-cart .ast-woo-header-cart-info-wrap{ display:none; }
.ast-mobile-menu-trigger-minimal, .ast-mobile-menu-trigger-minimal .ast-button-wrap{ color:var(--ecn-ink) !important; }
.ast-mobile-popup-drawer .ast-mobile-popup-inner{ background:var(--ecn-white); }
.ast-mobile-popup-drawer .menu-link{ font-size:17px; font-weight:500; color:var(--ecn-ink) !important; }
/* footer */
.site-footer{ background:var(--ecn-olive-deep); color:rgba(255,255,255,.78); }
.site-footer a{ color:#fff; }
.site-footer a:hover{ color:#0D585F; }
.site-primary-footer-wrap, .site-below-footer-wrap{ background:transparent !important; }
.site-primary-footer-wrap{ padding-top:44px; padding-bottom:28px; }
.site-below-footer-wrap{ border-top:1px solid rgba(255,255,255,.12); padding:18px 0; }
.site-below-footer-wrap .ast-footer-copyright{ font-size:13px; color:rgba(255,255,255,.6); }
.site-below-footer-wrap .ast-footer-copyright p{ margin:0; }
.ecn-foot-brand img{ height:28px; width:auto; filter:brightness(0) invert(1); opacity:.95; margin-bottom:14px; }
.ecn-foot-brand p{ font-size:14px; line-height:1.6; margin:0 0 16px; max-width:36ch; }
.ecn-foot-social{ display:flex; gap:8px; flex-wrap:wrap; }
.ecn-foot-social a{ display:inline-flex; align-items:center; min-height:38px; padding:0 14px; border:1px solid rgba(255,255,255,.25); border-radius:999px; font-size:13px; font-weight:600; text-decoration:none; }
.ecn-foot-social a:hover{ background:rgba(255,255,255,.08); color:#fff; }
.ecn-foot-links h4{ color:#fff; font-family:var(--ecn-font-head); font-weight:500; font-size:18px; margin:0 0 12px; }
.ecn-foot-links a{ display:block; font-size:14px; padding:6px 0; text-decoration:none; }
.ecn-foot-note{ font-size:13px; margin:12px 0 0; color:rgba(255,255,255,.6); }
@media (max-width:768px){ .site-primary-footer-wrap{ padding-top:36px; } .site-footer .ast-builder-grid-row > *{ margin-bottom:22px; } .ecn-foot-brand img{ height:26px; } }

/* ---- patch 3: footer columns ---- */
.ecn-foot-cols{ display:grid; grid-template-columns:1fr 1fr; gap:20px; }

/* ---- patch 4: footer alignment, site title ---- */
.site-footer .ast-builder-html-element, .site-footer .ast-footer-row{ text-align:left; }
.site-footer .ast-builder-grid-row{ align-items:start; }
.site-title, .site-description{ display:none !important; }
@media (max-width:768px){ .site-footer .ast-builder-html-element{ text-align:left; } }

/* ---- patch 5: product meta, footer align ---- */
.single-product .product_meta{ display:none !important; }
.site-footer .ast-builder-html-element{ text-align:left !important; }
.single-product .woocommerce-breadcrumb{ font-size:12px; color:var(--ecn-muted); margin-bottom:8px; }
.single-product .ast-woo-product-category{ font-size:11px; letter-spacing:.1em; text-transform:uppercase; color:var(--ecn-olive); }
@media (max-width:921px){ body.single-product{ padding-bottom:72px; } }

/* ---- patch 6: homepage v2 components ---- */
/* section headers with side link */
.ecn-head{ display:flex; align-items:flex-end; justify-content:space-between; gap:16px; }
.ecn-head.ecn-center{ display:block; }
.ecn-head-link{ flex:none; display:inline-flex; align-items:center; gap:2px; font-size:14px; font-weight:600; color:var(--ecn-olive-dark) !important; text-decoration:none !important; padding-bottom:6px; white-space:nowrap; }
.ecn-head-link svg{ width:16px; height:16px; }
.ecn-sec-hero > .e-con-inner{ max-width:100% !important; padding:0 !important; }
/* hero v2 */
.ecn-hero2{ position:relative; }
.ecn-hero2-media img{ width:100%; height:auto; aspect-ratio:4/4.4; object-fit:cover; object-position:center 30%; display:block; }
.ecn-hero2-copy{ position:absolute; left:0; right:0; bottom:0; padding:80px 20px 26px; background:linear-gradient(180deg,rgba(8,26,28,0) 0%,rgba(8,26,28,.55) 35%,rgba(8,26,28,.86) 100%); color:#fff; }
.ecn-hero2-copy .ecn-eyebrow{ color:#CFE3E4; margin-bottom:10px; font-size:11px; }
.ecn-hero2-copy h1{ font-family:var(--ecn-font-head); font-size:36px; line-height:1.05; font-weight:500; margin:0 0 12px; color:#fff; letter-spacing:-.015em; }
.ecn-hero2-copy p{ font-size:15px; line-height:1.55; color:rgba(255,255,255,.85); margin:0 0 18px; max-width:46ch; }
.ecn-hero2-cta{ display:flex; flex-direction:column; gap:12px; align-items:flex-start; }
.ecn-hero2-cta .ecn-btn-primary{ background:#fff; color:var(--ecn-olive-deep) !important; box-shadow:0 10px 24px rgba(0,0,0,.25); width:100%; }
.ecn-hero2-cta .ecn-btn-primary:hover{ background:var(--ecn-sand); }
.ecn-hero2-link{ color:#fff !important; font-size:14px; font-weight:600; text-decoration:none !important; border-bottom:1px solid rgba(255,255,255,.5); padding-bottom:2px; }
/* category chips */
.ecn-chips{ display:flex; gap:10px; overflow-x:auto; padding:2px 16px 8px; scroll-snap-type:x proximity; -webkit-overflow-scrolling:touch; scrollbar-width:none; }
.ecn-chips::-webkit-scrollbar{ display:none; }
.ecn-chip{ flex:none; scroll-snap-align:start; display:inline-flex; align-items:center; gap:8px; padding:6px 14px 6px 6px; border:1px solid var(--ecn-line); border-radius:999px; background:#fff; font-size:13px; font-weight:600; color:var(--ecn-ink) !important; text-decoration:none !important; min-height:44px; }
.ecn-chip-img{ width:32px; height:32px; border-radius:50%; overflow:hidden; display:grid; place-items:center; background:var(--ecn-olive-soft); color:var(--ecn-olive-dark); flex:none; }
.ecn-chip-img img{ width:100%; height:100%; object-fit:cover; display:block; }
.ecn-chip-img svg{ width:16px; height:16px; }
.ecn-chip:hover{ border-color:var(--ecn-olive); }
/* compact trust strip */
.ecn-trust{ display:grid; grid-template-columns:repeat(4,1fr); gap:6px; }
.ecn-trust div{ display:flex; flex-direction:column; align-items:center; gap:6px; text-align:center; padding:10px 4px; background:var(--ecn-sand); border-radius:12px; }
.ecn-trust .ecn-ico{ width:32px; height:32px; border-radius:50%; background:#fff; color:var(--ecn-olive-dark); display:grid; place-items:center; }
.ecn-trust .ecn-ico svg{ width:16px; height:16px; }
.ecn-trust b{ font-size:11px; font-weight:600; line-height:1.2; color:var(--ecn-ink); }
/* product cards (shortcode) */
.ecn-cards{ display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; }
.ecn-card{ background:#fff; border:1px solid var(--ecn-line); border-radius:var(--ecn-radius-sm); overflow:hidden; display:flex; flex-direction:column; transition:transform .2s ease, box-shadow .2s ease; }
.ecn-card:hover{ transform:translateY(-3px); box-shadow:var(--ecn-shadow); }
.ecn-card-img{ display:block; background:var(--ecn-beige); }
.ecn-card-img img{ width:100%; height:auto; aspect-ratio:4/5; object-fit:cover; display:block; }
.ecn-card-body{ padding:10px 12px 12px; display:flex; flex-direction:column; flex:1; }
.ecn-card-cat{ font-size:10px; letter-spacing:.1em; text-transform:uppercase; color:var(--ecn-olive); font-weight:600; margin-bottom:3px; }
.ecn-card-title{ font-family:var(--ecn-font-head); font-weight:500; font-size:16px; line-height:1.2; margin:0 0 3px; }
.ecn-card-title a{ color:var(--ecn-ink) !important; text-decoration:none !important; }
.ecn-card-skin{ font-size:12px; color:var(--ecn-muted); line-height:1.35; margin-bottom:8px; }
.ecn-card-pricing{ display:flex; align-items:baseline; gap:6px; margin-bottom:10px; margin-top:auto; }
.ecn-card-price{ font-weight:700; font-size:16px; color:var(--ecn-olive-dark); }
.ecn-card-price .woocommerce-Price-amount{ color:inherit; }
.ecn-card-size{ font-size:11px; color:var(--ecn-muted); }
.ecn-card-price-soon{ font-size:13px; font-weight:600; color:var(--ecn-clay); }
.ecn-card-actions{ display:flex; flex-direction:column; gap:6px; }
.ecn-card-order{ display:flex; align-items:center; justify-content:center; min-height:44px; border-radius:999px; background:var(--ecn-olive-dark); color:#fff !important; font-weight:600; font-size:14px; text-decoration:none !important; }
.ecn-card-order:hover{ background:var(--ecn-olive-deep); }
.ecn-card-order.ecn-card-soon{ background:var(--ecn-beige); color:var(--ecn-brown) !important; }
.ecn-card-view{ display:flex; align-items:center; justify-content:center; min-height:36px; font-size:13px; font-weight:600; color:var(--ecn-olive-dark) !important; text-decoration:none !important; border:1px solid rgba(16,42,45,.25); border-radius:999px; }
.ecn-card-view:hover{ background:rgba(16,42,45,.06); }
/* finder */
.ecn-finder{ display:grid; gap:10px; }
.ecn-find{ display:flex; align-items:center; gap:12px; padding:10px 12px 10px 10px; background:#fff; border:1px solid var(--ecn-line); border-radius:var(--ecn-radius-sm); text-decoration:none !important; color:var(--ecn-ink) !important; transition:transform .15s ease, box-shadow .2s ease; }
.ecn-find:hover{ transform:translateY(-2px); box-shadow:var(--ecn-shadow); }
.ecn-find img{ width:64px; height:64px; border-radius:12px; object-fit:cover; flex:none; }
.ecn-find div{ flex:1; min-width:0; }
.ecn-find small{ display:block; font-size:11px; letter-spacing:.06em; text-transform:uppercase; color:var(--ecn-olive); font-weight:600; margin-bottom:2px; }
.ecn-find b{ display:block; font-family:var(--ecn-font-head); font-weight:500; font-size:17px; line-height:1.15; }
.ecn-find span{ font-size:12px; color:var(--ecn-muted); }
.ecn-find svg{ width:20px; height:20px; color:var(--ecn-olive-dark); flex:none; }
/* reviews: horizontal snap on mobile */
.ecn-sec-reviews .ecn-head{ padding:0 16px; }
.ecn-reviews2{ display:flex; gap:12px; overflow-x:auto; padding:4px 16px 12px; scroll-snap-type:x mandatory; scrollbar-width:none; }
.ecn-reviews2::-webkit-scrollbar{ display:none; }
.ecn-reviews2 .ecn-review{ flex:0 0 82%; scroll-snap-align:start; }
/* connect */
.ecn-connect{ display:grid; gap:18px; }
.ecn-connect-btns{ display:grid; gap:10px; }
.ecn-connect-btn{ display:flex; align-items:center; justify-content:center; gap:10px; min-height:54px; border-radius:999px; font-weight:600; font-size:16px; text-decoration:none !important; color:#fff !important; }
.ecn-connect-btn svg{ width:22px; height:22px; }
.ecn-connect-wa{ background:#0D585F; }
.ecn-connect-fb{ background:#1877F2; }
.ecn-connect-btn:hover{ filter:brightness(.95); }
/* floating WhatsApp */
.ecn-wa-float{ position:fixed; right:14px; bottom:18px; z-index:9990; display:flex; align-items:center; gap:8px; background:#0D585F; color:#fff !important; text-decoration:none !important; border-radius:999px; padding:12px 16px 12px 12px; font-weight:600; font-size:14px; box-shadow:0 10px 24px rgba(0,0,0,.22); }
.ecn-wa-float svg{ width:24px; height:24px; }
body.single-product .ecn-wa-float{ bottom:84px; }
.ast-scroll-to-top-right{ display:none !important; }
@media (min-width:600px){
  .ecn-trust{ gap:12px; }
  .ecn-trust div{ flex-direction:row; justify-content:center; gap:10px; padding:12px; }
  .ecn-trust b{ font-size:13px; }
  .ecn-cards{ gap:16px; }
  .ecn-card-actions{ flex-direction:row; }
  .ecn-card-order{ flex:1; }
  .ecn-card-view{ flex:1; min-height:44px; }
  .ecn-finder{ grid-template-columns:repeat(2,1fr); }
  .ecn-connect-btns{ grid-template-columns:1fr 1fr; }
  .ecn-hero2-cta{ flex-direction:row; align-items:center; gap:22px; }
  .ecn-hero2-cta .ecn-btn-primary{ width:auto; }
  .ecn-reviews2{ overflow:visible; padding:0; display:grid; grid-template-columns:repeat(3,1fr); }
  .ecn-reviews2 .ecn-review{ flex:auto; }
  .ecn-sec-reviews .ecn-head{ padding:0; }
  .ecn-chips{ padding:0 0 4px; }
}
@media (min-width:900px){
  .ecn-sec-hero > .e-con-inner{ max-width:1140px !important; padding:0 20px !important; }
  .ecn-hero2{ display:grid; grid-template-columns:1fr 1fr; gap:56px; align-items:center; }
  .ecn-hero2-media{ order:2; }
  .ecn-hero2-media img{ aspect-ratio:4/5; border-radius:var(--ecn-radius); box-shadow:var(--ecn-shadow); }
  .ecn-hero2-copy{ position:static; padding:0; background:none; color:var(--ecn-ink); }
  .ecn-hero2-copy .ecn-eyebrow{ color:var(--ecn-olive); font-size:12px; }
  .ecn-hero2-copy h1{ font-size:60px; color:var(--ecn-ink); }
  .ecn-hero2-copy p{ font-size:18px; color:var(--ecn-muted); }
  .ecn-hero2-cta .ecn-btn-primary{ background:var(--ecn-olive-dark); color:#fff !important; box-shadow:0 8px 20px rgba(16,42,45,.22); }
  .ecn-hero2-cta .ecn-btn-primary:hover{ background:var(--ecn-olive-deep); }
  .ecn-hero2-link{ color:var(--ecn-olive-dark) !important; border-bottom-color:rgba(16,42,45,.4); }
  .ecn-cards{ grid-template-columns:repeat(5,minmax(0,1fr)); gap:16px; }
  .ecn-card-actions{ flex-direction:column; }
  .ecn-finder{ grid-template-columns:repeat(3,1fr); gap:14px; }
  .ecn-connect{ grid-template-columns:1.2fr 1fr; align-items:center; gap:40px; }
  .ecn-wa-float{ right:24px; bottom:24px; }
}

/* ---- patch 7: hero desktop alignment, header icons ---- */
@media (min-width:900px){ .ecn-sec-hero .ecn-hero2{ max-width:1140px; margin:0 auto; } .ecn-hero2-media img{ aspect-ratio:1/1.08; max-height:620px; } }
.ast-site-header-cart .ast-cart-menu-wrap, .ast-site-header-cart a{ color:var(--ecn-ink) !important; }
.ast-site-header-cart .ast-site-header-cart-li{ padding:0; }
.ast-header-search .astra-search-icon, .ast-header-account-wrap .ast-header-account-type-icon svg, .ast-header-search .ast-icon svg{ color:var(--ecn-ink); fill:var(--ecn-ink); }
.ast-mobile-header-content, .ast-mobile-popup-drawer{ font-family:var(--ecn-font-body); }


/* ============================================================
   ECONUR v3 (Econur Earth design) - homepage components
   Elementor 4.x optimized markup: no .elementor-widget-container
   ============================================================ */
:root{ --ecn-line:#E8E2D6; }

/* Native Elementor widgets used on the homepage */
.ecn-h1 .elementor-heading-title, .ecn-h2 .elementor-heading-title{ font-family:var(--ecn-font-head); font-weight:500; letter-spacing:-.015em; color:var(--ecn-ink); margin:0; }
.ecn-h2 .elementor-heading-title{ font-size:28px; line-height:1.08; }
.elementor-widget-text-editor.ecn-p{ font-family:var(--ecn-font-body); font-size:16px; line-height:1.55; color:var(--ecn-muted); max-width:56ch; }
.elementor-widget-text-editor.ecn-p p{ margin:0; }
.elementor-widget-text-editor.ecn-pc{ margin-left:auto; margin-right:auto; text-align:center; }
.elementor-widget-button.ecn-btn-primary .elementor-button,
.elementor-widget-button.ecn-btn-outline .elementor-button,
.elementor-widget-button.ecn-btn-invert .elementor-button,
.elementor-widget-button.ecn-btn-channel .elementor-button{
  font-family:var(--ecn-font-body) !important; font-weight:600 !important; font-size:16px !important; line-height:1 !important;
  border-radius:999px !important; min-height:52px; padding:16px 26px !important; display:inline-flex; align-items:center; justify-content:center; gap:10px;
  border:1.5px solid transparent !important; transition:background .2s ease, transform .15s ease; box-shadow:none;
}
.elementor-widget-button.ecn-btn-primary .elementor-button{ background:var(--ecn-olive-dark) !important; color:#fff !important; box-shadow:0 8px 20px rgba(16,42,45,.22) !important; }
.elementor-widget-button.ecn-btn-primary .elementor-button:hover{ background:var(--ecn-olive-deep) !important; }
.elementor-widget-button.ecn-btn-outline .elementor-button{ background:transparent !important; color:var(--ecn-olive-dark) !important; border-color:rgba(16,42,45,.35) !important; }
.elementor-widget-button.ecn-btn-outline .elementor-button:hover{ background:rgba(16,42,45,.06) !important; }
.elementor-widget-button.ecn-btn-invert .elementor-button{ background:var(--ecn-white) !important; color:var(--ecn-olive-deep) !important; }
.elementor-widget-button.ecn-btn-invert .elementor-button:hover{ background:var(--ecn-sand) !important; }
.elementor-widget-button.ecn-btn-channel .elementor-button{ background:#0D585F !important; color:#fff !important; }
.elementor-widget-button.ecn-btn-channel .elementor-button:hover{ filter:brightness(.95); }
.elementor-widget-button .elementor-button:active{ transform:scale(.98); }
.elementor-widget-button .elementor-button-icon{ display:inline-flex; }
.elementor-widget-button .elementor-button-icon i{ font-size:18px; }
.elementor-widget-button .elementor-button-icon svg{ width:18px; height:18px; }
.ecn-dark .ecn-h2 .elementor-heading-title{ color:#fff; }
.ecn-dark .elementor-widget-text-editor.ecn-p{ color:rgba(255,255,255,.8); }
.ecn-mt-8{ margin-top:8px; } .ecn-mt-16{ margin-top:16px; } .ecn-mt-24{ margin-top:24px; }
.e-con .elementor-widget:not(:last-child){ margin-bottom:0; }

/* Hero v3: image edge to edge with copy over a scrim on phones; split on desktop */
.ecn-hero3 > .e-con-inner{ max-width:100% !important; padding:0 !important; position:relative; }
.ecn-hero3-media img{ display:block; width:100%; aspect-ratio:4/4.5; object-fit:cover; object-position:center 30%; height:auto; }
.e-con.ecn-hero3-copy{ --position:absolute; position:absolute; left:0; right:0; bottom:0; padding:72px 20px 26px; background:linear-gradient(180deg,rgba(8,26,28,0) 0%,rgba(8,26,28,.55) 35%,rgba(8,26,28,.86) 100%); }
.ecn-hero3-copy .ecn-h1 .elementor-heading-title{ font-size:36px; line-height:1.05; color:#fff; margin:0 0 10px; }
.ecn-hero3-copy .elementor-widget-text-editor.ecn-p{ color:rgba(255,255,255,.86); font-size:15px; max-width:44ch; margin-bottom:18px; }
.ecn-hero3-copy .elementor-widget-button.ecn-btn-primary .elementor-button{ background:var(--ecn-white) !important; color:var(--ecn-olive-deep) !important; box-shadow:0 10px 24px rgba(0,0,0,.25) !important; width:100%; }

/* Trust strip: one flat row, no cards */
.ecn-trust3{ list-style:none; margin:0; padding:10px 0; display:grid; grid-template-columns:repeat(4,1fr); gap:4px; border-top:1px solid var(--ecn-line); border-bottom:1px solid var(--ecn-line); }
.ecn-trust3 li{ display:flex; flex-direction:column; align-items:center; gap:6px; text-align:center; }
.ecn-trust3 .ecn-ico{ width:30px; height:30px; border-radius:50%; background:var(--ecn-olive-soft); color:var(--ecn-olive-dark); display:grid; place-items:center; }
.ecn-trust3 .ecn-ico svg{ width:15px; height:15px; }
.ecn-trust3 b{ font-size:11px; font-weight:600; line-height:1.2; color:var(--ecn-ink); }

/* Packaging promise: copy + numbered list (no card row) */
.ecn-steps3{ list-style:none; margin:0; padding:0; border-top:1px solid rgba(255,255,255,.14); }
.ecn-steps3 li{ display:flex; gap:16px; align-items:flex-start; padding:16px 0; border-bottom:1px solid rgba(255,255,255,.14); color:#fff; }
.ecn-steps3 .ecn-num{ font-family:var(--ecn-font-head); font-size:26px; line-height:1; color:#0D585F; width:38px; flex:none; }
.ecn-steps3 b{ display:block; font-size:16px; font-weight:600; margin-bottom:3px; }
.ecn-steps3 span{ font-size:14px; line-height:1.5; color:rgba(255,255,255,.78); }
.ecn-story-cta{ margin-top:12px; }

/* Reviews v3: swipe on phones, staggered on desktop */
.ecn-rev3{ display:flex; gap:12px; overflow-x:auto; padding:4px 16px 12px; scroll-snap-type:x mandatory; scrollbar-width:none; }
.ecn-rev3::-webkit-scrollbar{ display:none; }
.ecn-rev3 .ecn-review{ flex:0 0 82%; scroll-snap-align:start; box-shadow:none; }
.ecn-rev3 .ecn-review p{ font-family:var(--ecn-font-head); font-size:18px; line-height:1.35; font-weight:400; }
.ecn-sec-rev3 .ecn-h2{ padding:0 16px; }

/* Made with care: image + short list */
.ecn-made{ display:grid; gap:20px; }
.ecn-made-img img{ width:100%; height:auto; aspect-ratio:4/5; object-fit:cover; border-radius:var(--ecn-radius); display:block; }
.ecn-made-list{ list-style:none; margin:0; padding:0; }
.ecn-made-list li{ padding:14px 0; border-top:1px solid var(--ecn-line); }
.ecn-made-list b{ display:block; font-family:var(--ecn-font-head); font-weight:500; font-size:18px; margin-bottom:3px; }
