/* ---- v3.8: mobile gutters for shop / cart / checkout + footer clearance ---- */
body{ overflow-x:hidden; }
@media (max-width:921px){
  /* one consistent 16px gutter on every non Elementor page (home keeps its full bleed) */
  body:not(.elementor-page) .site-content > .ast-container{ padding-left:16px !important; padding-right:16px !important; }
