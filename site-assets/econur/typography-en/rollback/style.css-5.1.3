/* you may also like */
.ecn-aml{ margin:30px 0 8px; }
.ecn-aml-head{ display:flex; align-items:baseline; justify-content:space-between; gap:12px; margin:0 0 12px; }
.ecn-aml-title{ font-family:var(--ecn-font-head) !important; font-weight:500 !important; font-size:22px !important; line-height:1.15; margin:0 !important; color:var(--ecn-ink) !important; }
.ecn-aml-all{ font-size:13px; font-weight:600; color:var(--ecn-muted) !important; text-decoration:none !important; }
.ecn-aml-track{ display:flex; gap:10px; overflow-x:auto; scroll-snap-type:x mandatory; scrollbar-width:none; margin:0 -16px; padding:2px 16px 8px; }
