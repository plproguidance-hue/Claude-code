/* ==========================================================================
   v5.0: one brand palette across the whole store
   Teal            #0D585F  fills, prices, links, active states
   Teal dark       #0A474D  hover and pressed
   Teal mid        #3E7A7F  small uppercase labels, bullet dots
   Teal tint       #E7F1F1  decorative icon circles, info pills
   Teal wash       #F0F6F6  large tinted panels
   Teal line       #D5E6E7  dividers on tinted panels
   Neutrals        ink #2A2823, body #4D4A42, muted #6E6A60, line #E8E5DF,
                   soft row #F5F6F2, field border #D6D2C8
   Rules: white text on every teal fill. Outline buttons are teal text on
   white with a teal border. Decorative icons sit on the tint. Stars stay
   gold and low stock stays clay.
   ========================================================================== */
:root{
  --ecn-teal:#0D585F; --ecn-teal-dark:#0A474D; --ecn-teal-mid:#3E7A7F;
  --ecn-teal-soft:#E7F1F1; --ecn-teal-wash:#F0F6F6; --ecn-teal-line:#D5E6E7;
  --ecn-field:#D6D2C8;
  --ecn-olive:#3E7A7F; --ecn-olive-dark:#0D585F; --ecn-olive-deep:#0D585F; --ecn-olive-soft:#E7F1F1;
  --ecn-btn:#0D585F; --ecn-btn-hover:#0A474D; --ecn-btn-line:#0D585F; --ecn-on-btn:#FFFFFF;
  --ecn-shadow:0 10px 30px rgba(16,42,45,.10);
}
::selection{ background:var(--ecn-teal-soft); color:var(--ecn-ink); }

/* announcement bar: white on teal */
.ecn.ecn-announce, .ecn-announce{ background:var(--ecn-teal) !important; color:#fff !important; }
.ecn-announce strong, .ecn-announce b, .ecn-announce a, .ecn-announce span{ color:#fff !important; }

/* header: every utility icon in ink, cart count in teal */
.menu-toggle.ast-mobile-menu-trigger-minimal{ color:var(--ecn-ink) !important; }
.ast-mobile-menu-trigger-minimal svg, .ast-mobile-menu-trigger-minimal .ast-mobile-svg{ fill:var(--ecn-ink) !important; }
.ast-site-header-cart i.astra-icon, .ast-site-header-cart .ast-icon, .ast-site-header-cart .ast-icon svg,
.ast-site-header-cart .ast-cart-menu-wrap{ color:var(--ecn-ink) !important; fill:var(--ecn-ink) !important; }
.ast-site-header-cart i.astra-icon::after, .ast-site-header-cart i.astra-icon:after{ background:var(--ecn-teal) !important; color:#fff !important; }
.ast-header-account-wrap svg, .ast-header-account-link svg,
.ast-header-search svg, .astra-search-icon svg, .ast-search-menu-icon svg{ fill:var(--ecn-ink) !important; color:var(--ecn-ink) !important; }
.ast-primary-header-bar{ border-bottom-color:var(--ecn-line) !important; }
.main-header-menu .menu-item:hover > .menu-link, .main-header-menu .current-menu-item > .menu-link,
.main-header-menu .current-menu-ancestor > .menu-link, .ast-builder-menu-mobile .main-navigation .menu-item.current-menu-item > .menu-link{ color:var(--ecn-teal) !important; }

/* outline (secondary) buttons: teal text and border on white */
.single-product form.cart .single_add_to_cart_button,
.elementor-widget-button.ecn-btn-outline .elementor-button, a.ecn-btn.ecn-btn-ghost,
.woocommerce ul.products li.product .ecn-pc-btn.ecn-pc-btn-soft, .ecn-pc-btn.ecn-pc-btn-soft{
  background:#fff !important; background-color:#fff !important; color:var(--ecn-teal) !important; border:1.5px solid var(--ecn-teal) !important;
}
.single-product form.cart .single_add_to_cart_button:hover, .single-product form.cart .single_add_to_cart_button:focus-visible,
.elementor-widget-button.ecn-btn-outline .elementor-button:hover, a.ecn-btn.ecn-btn-ghost:hover,
.woocommerce ul.products li.product .ecn-pc-btn.ecn-pc-btn-soft:hover, .ecn-pc-btn.ecn-pc-btn-soft:hover{
  background:var(--ecn-teal) !important; background-color:var(--ecn-teal) !important; color:#fff !important;
}
.elementor-widget-button .elementor-button .elementor-button-text, .elementor-widget-button .elementor-button svg{ color:inherit !important; fill:currentColor; }

/* selected states: solid teal, white label */
.ecn-arch-chip.is-on, .ecn-pc-sz.is-on, .ecn-pd-sz.is-on,
.woocommerce nav.woocommerce-pagination ul li span.current{ background:var(--ecn-teal) !important; border-color:var(--ecn-teal) !important; color:#fff !important; }
.ecn-arch-chip.is-on{ color:#fff !important; }
.ecn-pd-sz.is-on .ecn-sz-l{ color:#fff !important; }
.ecn-pd-sz.is-on .ecn-sz-p, .ecn-pd-sz.is-on .ecn-sz-p *{ color:rgba(255,255,255,.85) !important; }
.ecn-arch-chip:not(.is-on):hover, .ecn-pc-sz:not(.is-on):hover, .ecn-pd-sz:not(.is-on):hover, .ecn-chip:hover{ border-color:var(--ecn-teal) !important; }

/* badges and the saving pill */
.ecn-pc-badge-sale{ background:var(--ecn-teal-dark) !important; color:#fff !important; }
.ecn-pc-badge-soon, .ecn-pd-badge{ background:var(--ecn-teal) !important; color:#fff !important; }
.ecn-pd-off{ background:var(--ecn-teal-soft) !important; color:var(--ecn-teal) !important; }

/* informational pills and decorative icons sit on the tint */
.ecn-pd-pill{ background:var(--ecn-teal-soft) !important; color:var(--ecn-teal) !important; }
.ecn-pd-ico, .ecn-badge .ecn-ico, .ecn-ing .ecn-ico, .ecn-trust3 .ecn-ico, .ecn-hero-chip .ecn-leaf, .ecn-chip-img{
  background:var(--ecn-teal-soft) !important; color:var(--ecn-teal) !important;
}
.ecn-faq summary::after{ background:var(--ecn-teal-soft) !important; color:var(--ecn-teal) !important; }
.ecn-faq details[open] > summary::after{ background:var(--ecn-teal) !important; color:#fff !important; }
.ecn-pd-benefits li::before{ background:var(--ecn-teal) !important; color:#fff !important; }

/* trust panel */
.ecn-trustx-list{ background:var(--ecn-teal-wash) !important; }
.ecn-trustx-item + .ecn-trustx-item{ border-left-color:var(--ecn-teal-line) !important; }
.ecn-trustx-ico{ background:#fff !important; color:var(--ecn-teal) !important; }

/* product page details */
.ecn-pd-row:hover, .ecn-pd-row:focus{ background:#E9F2F2 !important; }
.ecn-buybar-wa{ color:var(--ecn-teal) !important; border-color:var(--ecn-line) !important; }
.ecn-buybar-wa:hover, .ecn-buybar-wa:focus-visible{ border-color:var(--ecn-teal) !important; }
.ecn-buybar-btn b{ border-left-color:rgba(255,255,255,.35) !important; }
.ecn-qty-btn:hover, .ecn-qty-btn:focus{ color:var(--ecn-teal) !important; }

/* footer */
.site-primary-footer-wrap, .site-below-footer-wrap{ border-top-color:var(--ecn-line) !important; }
.site-footer a:hover, .site-footer a:focus{ color:var(--ecn-teal) !important; }
.ecn-foot-social a:hover, .ecn-foot-social a:focus-visible{ background:var(--ecn-teal-soft) !important; color:var(--ecn-teal) !important; border-color:var(--ecn-teal-line) !important; }

/* classic WooCommerce forms (login, account, notices) */
.woocommerce form .form-row .input-text, .woocommerce form .form-row select, .woocommerce form .form-row textarea,
.woocommerce-page form .form-row .input-text, .woocommerce form.login input, .woocommerce form.register input{ border-color:var(--ecn-field) !important; }
.woocommerce form .form-row .input-text:focus, .woocommerce form .form-row select:focus, .woocommerce form .form-row textarea:focus,
.woocommerce-page form .form-row .input-text:focus{ border-color:var(--ecn-teal) !important; box-shadow:0 0 0 3px rgba(13,88,95,.14) !important; outline:none !important; }
.woocommerce form .required, .woocommerce-form .required{ color:#B42318 !important; }
.woocommerce-message, .woocommerce-info{ border-top-color:var(--ecn-teal) !important; }
.woocommerce-message::before, .woocommerce-info::before{ color:var(--ecn-teal) !important; }
.woocommerce form.login, .woocommerce form.register, .woocommerce form.checkout_coupon, .woocommerce form.lost_reset_password{ border-color:var(--ecn-line) !important; border-radius:16px; }

/* block cart and checkout */
body .wc-block-components-button:not(.is-link),
body .wc-block-components-checkout-place-order-button, body .wc-block-cart__submit-button{
  background:var(--ecn-teal) !important; background-color:var(--ecn-teal) !important; color:#fff !important;
  border:0 !important; border-radius:999px !important; box-shadow:none !important;
}
body .wc-block-components-button:not(.is-link):hover, body .wc-block-components-button:not(.is-link):focus-visible,
body .wc-block-components-checkout-place-order-button:hover, body .wc-block-cart__submit-button:hover{
  background:var(--ecn-teal-dark) !important; background-color:var(--ecn-teal-dark) !important; color:#fff !important;
}
body .wc-block-components-button:not(.is-link) .wc-block-components-button__text{ color:#fff !important; }
body .wc-block-components-text-input input, body .wc-block-components-textarea,
body .wc-blocks-components-select .wc-blocks-components-select__select,
body .wc-block-components-totals-coupon__input input{ border:1px solid var(--ecn-field) !important; border-radius:10px !important; }
body .wc-blocks-components-select .wc-blocks-components-select__container{ border-radius:10px !important; }
body .wc-block-components-text-input input:focus, body .wc-block-components-textarea:focus,
body .wc-blocks-components-select .wc-blocks-components-select__select:focus{
  border-color:var(--ecn-teal) !important; box-shadow:0 0 0 1px var(--ecn-teal) !important; outline:none !important;
}
.wc-block-components-radio-control--highlight-checked:after{ border-color:var(--ecn-line) !important; border-radius:12px !important; }
.wc-block-components-radio-control--highlight-checked .wc-block-components-radio-control-accordion-option--checked-option-highlighted,
.wc-block-components-radio-control--highlight-checked label.wc-block-components-radio-control__option--checked-option-highlighted{
  box-shadow:inset 0 0 0 1.5px var(--ecn-teal) !important; border-radius:0 !important; background:var(--ecn-teal-wash);
}
.wc-block-components-radio-control--highlight-checked > .wc-block-components-radio-control__option--checked-option-highlighted:first-child,
.wc-block-components-radio-control--highlight-checked > .wc-block-components-radio-control-accordion-option--checked-option-highlighted:first-child{ border-radius:12px 12px 0 0 !important; }
.wc-block-components-radio-control--highlight-checked > .wc-block-components-radio-control__option--checked-option-highlighted:last-child,
.wc-block-components-radio-control--highlight-checked > .wc-block-components-radio-control-accordion-option--checked-option-highlighted:last-child{ border-radius:0 0 12px 12px !important; }
.wc-block-components-radio-control--highlight-checked > .wc-block-components-radio-control__option--checked-option-highlighted:only-child,
.wc-block-components-radio-control--highlight-checked > .wc-block-components-radio-control-accordion-option--checked-option-highlighted:only-child{ border-radius:12px !important; }
.wc-block-components-radio-control .wc-block-components-radio-control__input:checked{ border-color:var(--ecn-teal) !important; }
.wc-block-components-radio-control .wc-block-components-radio-control__input:checked:before{ background:var(--ecn-teal) !important; }
.wc-block-components-radio-control .wc-block-components-radio-control__input:focus-visible,
